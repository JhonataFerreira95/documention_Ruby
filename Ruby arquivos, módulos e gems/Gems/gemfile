source "https://rubygems.org" # Para utilizamos às gems, estamos importando.

# Aqui importamos com <gem> o nome da nossa gem entre aspas <"faker"> e posteriomente a sua versão nesse seguimento <"~> 3.2.0">.

gem "faker", "~> 3.2.0" # Para funcionar utlizer esse comando no terminal <bundle install> para instalação da gem.
gem 'roo', '~> 2.10', '>= 2.10.1' 

# Aqui importamos a <gem> a nossa gem, no momento quero utilizar a <gem> chamada <"random"> para gerar número randomicos.

gem 'random', '~> 0.2.1'