source "https://rubygems.org" # Para utilizamos às gems, estamos importando.

# Aqui importamos com <gem> o nome da nossa gem entre aspas <"faker"> e posteriomente a sua versão nesse seguimento <"~> 3.2.0">.

gem "faker", "~> 3.2.0" # Para funcionar utlizer esse comando no terminal <bundle install> para instalação da gem.
gem 'roo', '~> 2.10', '>= 2.10.1' 

# Aqui importamos a <gem> a nossa gem, no momento quero utilizar a <gem> chamada <"securerandom"> para gerar número randomicos seguros, tanto int quanto float.

gem 'securerandom', '~> 0.1.0'

# Aqui importamos a <gem> a nossa gem, vou utilizar uma <gem> para debuggr chamada <"byebug"> para usa e descobrir os bug do código.

gem 'byebug', '~> 12.0'

# Aqui importei a <gem>, irei utilizar uma <gem> para utiliazação de estrutura no ruby chamada <ruby-lsp>.

group :development do
  gem "ruby-lsp"
end

# Aqui importe a <gem> para utilizar o posgresql, a <gem> chama-se <pg>.

gem 'pg', '~> 1.5', '>= 1.5.9'

# Aqui importei a <gem> para utlize o activerecord

gem 'activerecord-import', '~> 0.15.0'

# Aqui importei a <gem> para utilizar o mongodb via ruby

gem 'mongo', '~> 2.21'

# Aqui importei a <gem> para utilizar o redis via ruby

gem 'redis', '>= 5.4.1'

# Aqui importe a <gem> para utilizar o Json via ruby

gem 'json', '>= 2.20'
